rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorizedAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'swati.soam@primipassiedu.com' ||
         request.auth.token.email == 'swati.soam@primipassiedu.com'.lower() ||
         request.auth.token.email == 'shubham.it2006@gmail.com' ||
         request.auth.token.email == 'shubham.it2006@gmail.com'.lower());
    }

    // Lead Inquiries from Public Website
    match /leads/{leadId} {
      // Public visitors can submit (create) a new lead inquiry
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.fullName.size() < 200
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200
                    && request.resource.data.phone.size() > 3
                    && request.resource.data.phone.size() < 50;

      // Only authenticated authorized administrators can read, query, update, or delete/archive leads
      allow read, update, delete: if isAuthorizedAdmin();
    }

    // Dynamic Website Content & Settings
    match /content/{sectionId} {
      // Public website visitors can read dynamic content (universities, countries, scholarships, settings, etc.)
      allow read: if true;

      // Only authorized administrators can update, create, or modify dynamic website content
      allow write: if isAuthorizedAdmin();
    }

    // Media Library Assets & Uploaded Images
    match /media_items/{mediaId} {
      // Public website visitors can read media metadata and download URLs
      allow read: if true;

      // Only authenticated administrators can upload, replace, update metadata, or delete media items
      allow write: if isAuthorizedAdmin();
    }
  }
}
