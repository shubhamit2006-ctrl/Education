{
  "entities": {
    "lead": {
      "title": "Lead",
      "description": "Student admission consultation enquiries submitted from the public website",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Student full name"
        },
        "email": {
          "type": "string",
          "description": "Student contact email"
        },
        "phone": {
          "type": "string",
          "description": "Student phone / WhatsApp number"
        },
        "destinationCountry": {
          "type": "string",
          "description": "Preferred study destination"
        },
        "intake": {
          "type": "string",
          "description": "Target academic intake"
        },
        "degree": {
          "type": "string",
          "description": "Desired degree level"
        },
        "selectedSlot": {
          "type": "string",
          "description": "Preferred counseling time slot"
        },
        "callbackDate": {
          "type": "string",
          "description": "Requested consultation callback date"
        },
        "callbackTime": {
          "type": "string",
          "description": "Requested consultation callback time"
        },
        "prefilledDetails": {
          "type": "string",
          "description": "Inquiry context or prefilled details"
        },
        "status": {
          "type": "string",
          "description": "Lead management status (New, Contacted, In Consultation, Converted, Closed)"
        },
        "isArchived": {
          "type": "boolean",
          "description": "Whether lead is archived"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "createdAtMs": {
          "type": "number",
          "description": "Epoch timestamp in milliseconds for indexing and sorting"
        }
      },
      "required": ["fullName", "email", "phone"]
    },
    "contentSection": {
      "title": "ContentSection",
      "description": "Dynamic website content, universities, courses, destinations, and settings managed via admin",
      "type": "object",
      "properties": {
        "sectionId": {
          "type": "string",
          "description": "Identifier of the dynamic content section"
        },
        "updatedAt": {
          "type": "number",
          "description": "Epoch timestamp in milliseconds of last update"
        },
        "updatedBy": {
          "type": "string",
          "description": "Email or ID of updating admin"
        }
      }
    },
    "mediaItem": {
      "title": "MediaItem",
      "description": "Uploaded images and media metadata stored in Firebase Storage and Firestore",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Original file name"
        },
        "url": {
          "type": "string",
          "description": "Direct Firebase Storage download URL"
        },
        "storagePath": {
          "type": "string",
          "description": "Firebase Storage object path"
        },
        "sizeBytes": {
          "type": "number",
          "description": "File size in bytes"
        },
        "sizeFormatted": {
          "type": "string",
          "description": "Formatted file size (e.g. 1.2 MB)"
        },
        "contentType": {
          "type": "string",
          "description": "MIME type (e.g. image/jpeg, image/png)"
        },
        "uploadedAt": {
          "type": "string",
          "description": "Formatted upload date"
        },
        "uploadedAtMs": {
          "type": "number",
          "description": "Upload timestamp in milliseconds"
        },
        "uploadedBy": {
          "type": "string",
          "description": "Admin email who uploaded the image"
        },
        "altText": {
          "type": "string",
          "description": "Accessibility alt text"
        },
        "category": {
          "type": "string",
          "description": "Content category (universities, destinations, blogs, etc.)"
        }
      },
      "required": ["name", "url", "uploadedAtMs"]
    },
    "italyEligibilityLead": {
      "title": "ItalyEligibilityLead",
      "description": "Student submissions from Italy Eligibility Assessment Questionnaire",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Student full name"
        },
        "email": {
          "type": "string",
          "description": "Student email address"
        },
        "phone": {
          "type": "string",
          "description": "Student mobile / WhatsApp number"
        },
        "studyLevel": {
          "type": "string",
          "description": "Bachelor's or Master's"
        },
        "intendedField": {
          "type": "string",
          "description": "Selected field or course"
        },
        "intake": {
          "type": "string",
          "description": "Target intake"
        },
        "preliminaryEligibilityStatus": {
          "type": "string",
          "description": "ELIGIBLE | PROFILE_REVIEW | NOT_ELIGIBLE"
        },
        "counsellorStatus": {
          "type": "string",
          "description": "Current status of counsellor outreach"
        },
        "createdAt": {
          "type": "string",
          "description": "Formatted creation date"
        },
        "createdAtMs": {
          "type": "number",
          "description": "Timestamp in milliseconds"
        }
      },
      "required": ["fullName", "email", "phone", "studyLevel", "preliminaryEligibilityStatus"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "lead",
      "description": "Public student inquiry leads submitted from website"
    },
    "/italyEligibilityLeads/{leadId}": {
      "schema": "italyEligibilityLead",
      "description": "Student Italy Eligibility Assessment questionnaire submissions"
    },
    "/content/{sectionId}": {
      "schema": "contentSection",
      "description": "Dynamic website settings, destinations, universities, courses, and content"
    },
    "/media_items/{mediaId}": {
      "schema": "mediaItem",
      "description": "Uploaded media assets with persistent Firebase Storage URLs"
    }
  }
}
